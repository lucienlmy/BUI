---
// From README.md "Partial or in progress" and "Planned". Nothing here works yet unless it says so.
import Icon from "../site/Icon.astro";

const items = [
  { title: "macOS GPU and JavaScript windows", body: "The Cocoa host works (tried by hand on three Macs). Next there: the GPU renderer (Metal, or OpenGL) and Node windows on the main thread.", tag: "Planned" },
  { title: "WebAssembly", body: "The kit in the browser: the raster blits to a <canvas>, and React and the DOM-like API run on top, unchanged.", tag: "Planned" },
  { title: "egui", body: "BUI panels inside egui apps, plus a Blender-styled egui theme.", tag: "Planned" },
  { title: "Angular, Solid and Lit", body: "Thin adapters over @blender-ui/native, the layer React, Svelte and Vue already share.", tag: "Planned" },
  { title: "More languages", body: "Lua (a community pull request is in review), Ruby, Go through cgo, C#, Zig, Swift, Kotlin and MyGo over the same C header; Godot, Unity, Bevy and Flutter.", tag: "Planned" },
  { title: "Font fallback and more IME", body: "Per-glyph fallback (Blender's BLF), input methods on X11 and macOS (Windows has them), units in number fields and widget drag and drop.", tag: "Planned" },
  { title: "Vulkan and WebGPU", body: "More GPU backends drawing the same instance stream as Direct3D 11 and OpenGL.", tag: "Planned" },
  { title: "More Qt", body: "Date and calendar widgets, QThread, drag and drop and Qt stylesheets, on top of today's docks, toolbars, model/view and dialogs.", tag: "In progress" },
];
---

<ul class="grid gap-px bg-border sm:grid-cols-2 lg:grid-cols-4">
  {
    items.map((it) => (
      <li class="flex flex-col gap-2 bg-background p-5 sm:p-7">
        <span class="kicker inline-flex items-center gap-1.5 text-link">
          <Icon name={it.tag === "In progress" ? "circle-half" : "hourglass-medium"} weight="duotone" size={13} />
          {it.tag}
        </span>
        <h3 class="text-[17px] font-semibold leading-6">{it.title}</h3>
        <p class="text-[14.5px] leading-6 text-muted">{it.body}</p>
      </li>
    ))
  }
</ul>
